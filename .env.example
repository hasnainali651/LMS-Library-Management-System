NODE_ENV=development
PORT=5000
BACKEND_PORT=5000
MONGO_URI=mongodb://localhost:27017/lms_db?replicaSet=rs0
REDIS_URL=redis://:replace-with-local-redis-password@localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES_IN=30d
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-with-smtp-user
MAIL_PASS=replace-with-smtp-password
MAIL_FROM=Library <noreply@example.com>
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=replace-with-server-only-gemini-key
# Verify this documented stable candidate using check:ai before deployment.
GEMINI_MODEL=gemini-3.5-flash
LIBRARY_TIMEZONE=Asia/Karachi
RESERVATION_HOLD_HOURS=48
MAX_FILE_SIZE_MB=5
BCRYPT_ROUNDS=12
# Local Docker: npm run docker:prepare --workspace=backend
# Then: docker compose --env-file .env.docker.local up -d --build
# MongoDB and Redis have no published host ports.
